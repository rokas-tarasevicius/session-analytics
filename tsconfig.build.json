{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,
    "checkJs": false
  },
  "include": ["bin/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.d.ts"]
}
