{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:session-analytics:shared:1",
  "title": "SharedSnapshot",
  "description": "Generated by scripts/snapshot-schema.ts; field maps are checked against src/types.ts. Unknown fields are rejected.",
  "$ref": "#/$defs/SharedSnapshot",
  "$defs": {
    "SharedCounters": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "number",
          "minimum": 0
        },
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "pricedTokens": {
          "type": "number",
          "minimum": 0
        },
        "priceableTokens": {
          "type": "number",
          "minimum": 0
        },
        "apiEquivalentSpendUsd": {
          "type": "number",
          "minimum": 0
        },
        "providerReportedSpendUsd": {
          "type": "number",
          "minimum": 0
        },
        "estimatedUpperSpendUsd": {
          "type": "number",
          "minimum": 0
        },
        "toolCalls": {
          "type": "number",
          "minimum": 0
        },
        "compactions": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "sessions",
        "inputTokens",
        "outputTokens",
        "pricedTokens",
        "priceableTokens",
        "apiEquivalentSpendUsd",
        "providerReportedSpendUsd",
        "estimatedUpperSpendUsd",
        "toolCalls",
        "compactions"
      ],
      "additionalProperties": false
    },
    "SharedRepository": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "number",
          "minimum": 0
        },
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "pricedTokens": {
          "type": "number",
          "minimum": 0
        },
        "priceableTokens": {
          "type": "number",
          "minimum": 0
        },
        "apiEquivalentSpendUsd": {
          "type": "number",
          "minimum": 0
        },
        "providerReportedSpendUsd": {
          "type": "number",
          "minimum": 0
        },
        "estimatedUpperSpendUsd": {
          "type": "number",
          "minimum": 0
        },
        "toolCalls": {
          "type": "number",
          "minimum": 0
        },
        "compactions": {
          "type": "number",
          "minimum": 0
        },
        "repository": {
          "type": "string",
          "pattern": "^(repo-[a-f0-9]{32}|alias-[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"
        }
      },
      "required": [
        "sessions",
        "inputTokens",
        "outputTokens",
        "pricedTokens",
        "priceableTokens",
        "apiEquivalentSpendUsd",
        "providerReportedSpendUsd",
        "estimatedUpperSpendUsd",
        "toolCalls",
        "compactions",
        "repository"
      ],
      "additionalProperties": false
    },
    "SharedSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "shared"
        },
        "minimumSessions": {
          "type": "number",
          "minimum": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^source-[a-f0-9]{32}$"
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SharedRepository"
          }
        },
        "summary": {
          "$ref": "#/$defs/SharedCounters"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "minimumSessions",
        "sources",
        "repositories",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
