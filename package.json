{
  "name": "session-analytics",
  "version": "0.8.1",
  "description": "Content-free analytics for local coding-agent sessions: Claude Code, Codex, Cursor, Copilot CLI, OpenCode, and Gemini CLI usage, cost, and tools by repository.",
  "license": "MIT",
  "author": "Rokas Tarasevičius",
  "private": true,
  "type": "module",
  "bin": {
    "session-analytics": "bin/session-analytics.ts"
  },
  "files": [
    "CHANGELOG.md",
    "bin",
    "src",
    "data",
    "schemas",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokas-tarasevicius/session-analytics.git"
  },
  "homepage": "https://github.com/rokas-tarasevicius/session-analytics#readme",
  "bugs": {
    "url": "https://github.com/rokas-tarasevicius/session-analytics/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "coding-agents",
    "ai-agents",
    "analytics",
    "token-usage",
    "llm-cost",
    "privacy",
    "observability"
  ],
  "scripts": {
    "start": "node bin/session-analytics.ts",
    "report": "node bin/session-analytics.ts report",
    "demo": "node scripts/demo.ts",
    "test": "node scripts/test.ts",
    "test:browser": "node scripts/test.ts --browser",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "release:check": "npm run check && node scripts/release-check.ts",
    "verify:real": "node scripts/verify-real.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
